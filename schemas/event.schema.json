{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guilyx/jarvis_ros2/schemas/event.schema.json",
  "title": "Jarvis Event",
  "description": "The one record type Jarvis moves around. See docs/design/03-data-model.md §1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "stamp", "source", "kind", "code", "severity"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 64, "description": "UUIDv7, generated by the producer."},
    "seq": {"type": "string", "pattern": "^[0-9]{1,20}$", "description": "uint64 assigned by the event hub, as a decimal string."},
    "stamp": {"$ref": "#/$defs/timestamp"},
    "recv_stamp": {"$ref": "#/$defs/timestamp"},
    "source": {"$ref": "#/$defs/source"},
    "kind": {"enum": ["LOG", "STATE", "FAULT_RAISE", "FAULT_CLEAR", "FAULT_STATE", "RULE_MATCH", "RECOVERY", "INSIGHT", "OPERATOR", "SYSTEM"]},
    "code": {"$ref": "#/$defs/code"},
    "severity": {"$ref": "#/$defs/severity"},
    "message": {"type": "string", "maxLength": 1024},
    "attrs": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"minLength": 1, "maxLength": 64},
      "additionalProperties": {"type": ["string", "integer", "number", "boolean"]}
    },
    "tags": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
    "payload": {"type": "string", "maxLength": 65536},
    "payload_schema": {"type": "string"},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": "string"}
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "UTC, up to nanosecond precision."
    },
    "code": {"type": "string", "maxLength": 128, "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"},
    "severity": {"enum": ["DEBUG", "INFO", "WARN", "ERROR", "CRITICAL"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["robot", "node"],
      "properties": {
        "robot": {"type": "string"},
        "node": {"type": "string", "minLength": 1},
        "component": {"type": "string"},
        "host": {"type": "string"}
      }
    }
  }
}
