<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_nav2</name>
  <version>0.1.0</version>
  <description>Nav2 actuators for Jarvis recovery plans: lifecycle manager, costmaps, navigation goals.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/guilyx/jarvis_ros2</url>
  <url type="repository">https://github.com/guilyx/jarvis_ros2</url>
  <url type="bugtracker">https://github.com/guilyx/jarvis_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>jarvis_ros</depend>
  <depend>nav2_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
