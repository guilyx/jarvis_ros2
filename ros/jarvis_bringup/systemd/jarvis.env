# Jarvis's settings on this robot, read by jarvis.service (docs/guides/robot.md).

# The ROS 2 workspace Jarvis is installed in: its setup.bash (which sources ROS 2's).
ROS_SETUP=/opt/jarvis/setup.bash
# This robot's name: stamped on every event, shown by the dashboard and the fleet view.
JARVIS_ROBOT_ID=robot
# Recordings, black boxes, the lake and the fault state (the unit's StateDirectory).
JARVIS_DATA=/var/lib/jarvis

# The robot's ROS 2 network: the same domain as its other nodes.
ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# More launch arguments (ros2 launch jarvis_bringup jarvis.launch.py --show-args), for example
# the robot's rules and plans, and the gateway on the robot's network for the dashboard:
JARVIS_LAUNCH_ARGS=
# JARVIS_LAUNCH_ARGS=rules:=/etc/jarvis/rules plans:=/etc/jarvis/plans gateway_host:=0.0.0.0 gateway_config:=/etc/jarvis/gateway.yaml

# The fleet's history (docs/guides/fleet.md §4): the lake uploads it as it goes, e.g.
# JARVIS_LAUNCH_ARGS=lake_upload_to:=s3://acme-robots/jarvis
# with a key that may only write under its robot's prefix:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# SROS2 (docs/guides/security.md): the keystore, and Jarvis's launch enclave.
# ROS_SECURITY_KEYSTORE=/etc/jarvis/keystore
# ROS_SECURITY_ENABLE=true
# ROS_SECURITY_STRATEGY=Enforce
# ROS_SECURITY_ENCLAVE_OVERRIDE=/jarvis/launch

# The agent's model (optional; without one it uses the heuristic analyst).
# JARVIS_AGENT_MODEL=anthropic/<model>
# ANTHROPIC_API_KEY=
