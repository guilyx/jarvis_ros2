<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_lake</name>
  <version>0.1.0</version>
  <description>Jarvis history: converts recorded MCAP splits to Parquet, DuckDB views, KPIs, analytics and retention. Runs without ROS; the ROS adapter only listens for closed splits.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>

  <!-- Python dependencies are pinned in requirements.txt (pip): duckdb, mcap, mcap-ros2-support,
       pyarrow, pytz. The ROS ones below are only for the optional ROS adapter. -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>jarvis_reporter</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosbag2_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
