<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_demo</name>
  <version>0.1.0</version>
  <description>Jarvis demo: lidar relay with fault injection, a robot base to dock, fault injector, and launch files with and without a Nav2 simulation.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/guilyx/jarvis_ros2</url>
  <url type="repository">https://github.com/guilyx/jarvis_ros2</url>
  <url type="bugtracker">https://github.com/guilyx/jarvis_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>diagnostic_updater</exec_depend>
  <exec_depend>jarvis_bringup</exec_depend>
  <exec_depend>jarvis_bt</exec_depend>
  <exec_depend>jarvis_cli</exec_depend>
  <exec_depend>jarvis_interfaces</exec_depend>
  <exec_depend>jarvis_reporter</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- nav2_sim.launch.py also needs nav2_bringup and nav2_minimal_tb4_sim. They are not declared, so
       CI and robots that only run demo.launch.py don't pull in Nav2 and Gazebo. -->

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>ros2cli</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
