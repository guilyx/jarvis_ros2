{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guilyx/jarvis_ros2/schemas/insight.schema.json",
  "title": "Jarvis insight",
  "description": "What the agent concluded about a window of events (docs/design/03-data-model.md §8): the payload of INSIGHT events (payload_schema jarvis.insight/v1). Every evidence id is an event id the analyst saw.",
  "type": "object",
  "additionalProperties": false,
  "required": ["insight_id", "trigger", "window", "title", "summary", "assessment", "hypotheses", "recommendations", "degraded", "analyst"],
  "properties": {
    "insight_id": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["INCIDENT_OPENED", "RECOVERY_FAILED", "RULE_REQUEST", "DIGEST", "ON_DEMAND"] },
        "ref": { "type": "string", "description": "Incident id, event id or question" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "event_count"],
      "properties": {
        "from": { "type": "string", "format": "date-time" },
        "to": { "type": "string", "format": "date-time" },
        "event_count": { "type": "integer", "minimum": 0 },
        "correlation_id": { "type": "string" }
      }
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": { "type": "string", "maxLength": 4000 },
    "assessment": { "$ref": "event.schema.json#/$defs/severity" },
    "hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cause", "confidence", "evidence"],
        "properties": {
          "cause": { "type": "string", "minLength": 1, "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
          "counter_evidence": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
          "flagged": { "type": "boolean", "description": "The harness capped it: evidence was missing" }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "enum": ["RECOVER", "INVESTIGATE", "CONFIGURE", "ESCALATE"] },
          "text": { "type": "string", "minLength": 1, "maxLength": 500 },
          "plan_id": { "type": "string" },
          "args": { "type": "object", "additionalProperties": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "Execution ids of the plans it submitted (supervised / autonomous)"
    },
    "degraded": { "type": "boolean", "description": "The heuristic analyst answered instead of the model" },
    "analyst": { "enum": ["heuristic", "llm"] },
    "flags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "What the harness changed or noticed"
    },
    "facts": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 20,
      "description": "Deterministic findings of the triage (counts, orderings, durations)"
    },
    "model": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "name": { "type": "string" },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "created": { "type": "string", "format": "date-time" }
  }
}
