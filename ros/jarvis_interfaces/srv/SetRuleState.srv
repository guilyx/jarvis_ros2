# Enables/disables a rule or toggles its shadow mode at runtime. Survives a restart, not a reload.
uint8 KEEP=0
uint8 SET_TRUE=1
uint8 SET_FALSE=2
string rule_id
uint8 enabled                        # KEEP, SET_TRUE or SET_FALSE
uint8 dry_run                        # KEEP, SET_TRUE or SET_FALSE
string operator_name                 # who, for the audit trail (an OPERATOR event)
string reason
---
bool success
string message
