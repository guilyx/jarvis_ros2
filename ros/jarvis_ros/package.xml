<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_ros</name>
  <version>0.1.0</version>
  <description>ROS 2 layer of Jarvis: type adapters, the event hub, fault manager, rule engine and recovery lifecycle components, and the built-in actuators.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/guilyx/jarvis_ros2</url>
  <url type="repository">https://github.com/guilyx/jarvis_ros2</url>
  <url type="bugtracker">https://github.com/guilyx/jarvis_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>jarvis_core</depend>
  <depend>jarvis_interfaces</depend>
  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>pluginlib</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rcpputils</depend>
  <depend>rosbag2_interfaces</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
