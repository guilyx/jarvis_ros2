{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guilyx/jarvis_ros2/schemas/plans.schema.json",
  "title": "Jarvis recovery plans (jarvis.plans/v1)",
  "description": "Recovery plans: ordered steps with timeouts and retries, locks, admission gates and an on_failure escalation ladder. See docs/design/05-rules-and-recovery.md \u00a78-10. The C++ parser (jarvis_core::PlanSet) is stricter: it checks template variables, core action arguments and parameter defaults; PlanSet::validate() adds the cross-plan checks (known actions and plans, cycles, depth).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "jarvis.plans/v1"
    },
    "plans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plan"
      }
    }
  },
  "$defs": {
    "requesters": {
      "type": "array",
      "items": {
        "enum": [
          "RULE",
          "OPERATOR",
          "AGENT",
          "PLAN",
          "rule",
          "operator",
          "agent",
          "plan"
        ]
      }
    },
    "param": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "string",
            "int",
            "integer",
            "number",
            "bool",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "$ref": "rules.schema.json#/$defs/scalar"
        },
        "pattern": {
          "type": "string"
        },
        "one_of": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "rules.schema.json#/$defs/scalar"
          }
        },
        "description": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "required",
          "default"
        ],
        "properties": {
          "required": {
            "const": true
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "backoff": {
          "$ref": "rules.schema.json#/$defs/duration"
        },
        "multiplier": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 10.0
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_][a-z0-9_-]*$"
        },
        "action": {
          "type": "string",
          "description": "A core action (wait_for, delay, check, emit, run) or an actuator named <provider>.<name>.",
          "pattern": "^(wait_for|delay|check|emit|run|[a-z0-9_]+(\\.[a-z0-9_]+)+)$"
        },
        "with": {
          "type": "object"
        },
        "timeout": {
          "$ref": "rules.schema.json#/$defs/positive_duration"
        },
        "retry": {
          "$ref": "#/$defs/retry"
        },
        "when": {
          "$ref": "rules.schema.json#/$defs/guard"
        },
        "continue_on_failure": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "wait_for"
              }
            }
          },
          "then": {
            "required": [
              "with"
            ],
            "properties": {
              "with": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event"
                    ],
                    "properties": {
                      "event": {
                        "$ref": "rules.schema.json#/$defs/matcher"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "fault",
                      "state"
                    ],
                    "properties": {
                      "fault": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "code"
                        ],
                        "properties": {
                          "code": {
                            "type": "string"
                          },
                          "component": {
                            "type": "string"
                          }
                        }
                      },
                      "state": {
                        "enum": [
                          "ACTIVE",
                          "LATCHED",
                          "CLEARED"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "delay"
              }
            }
          },
          "then": {
            "required": [
              "with"
            ],
            "properties": {
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "duration"
                ],
                "properties": {
                  "duration": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "check"
              }
            }
          },
          "then": {
            "required": [
              "with"
            ],
            "properties": {
              "with": {
                "$ref": "rules.schema.json#/$defs/guard",
                "minProperties": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "emit"
              }
            }
          },
          "then": {
            "required": [
              "with"
            ],
            "properties": {
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code"
                ],
                "properties": {
                  "kind": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "attrs": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "rules.schema.json#/$defs/scalar"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "run"
              }
            }
          },
          "then": {
            "required": [
              "with"
            ],
            "properties": {
              "with": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan"
                ],
                "properties": {
                  "plan": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "args": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "rules.schema.json#/$defs/scalar"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "failure_step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "plan"
              ],
              "properties": {
                "plan": {
                  "type": "string"
                },
                "args": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "escalate"
          ],
          "properties": {
            "escalate": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/param"
          }
        },
        "locks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "on_conflict": {
          "enum": [
            "reject",
            "queue"
          ]
        },
        "queue_ttl": {
          "$ref": "rules.schema.json#/$defs/positive_duration"
        },
        "allowed_requesters": {
          "$ref": "#/$defs/requesters"
        },
        "agent_policy": {
          "enum": [
            "never",
            "observe",
            "advise",
            "supervised",
            "autonomous"
          ]
        },
        "requires_approval": {
          "$ref": "#/$defs/requesters"
        },
        "preconditions": {
          "$ref": "rules.schema.json#/$defs/guard"
        },
        "max_attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "count",
            "per"
          ],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "per": {
              "$ref": "rules.schema.json#/$defs/positive_duration"
            }
          }
        },
        "timeout": {
          "$ref": "rules.schema.json#/$defs/positive_duration"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "on_failure": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failure_step"
          }
        }
      }
    }
  }
}
