<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_cli</name>
  <version>0.1.0</version>
  <description>`ros2 jarvis`: faults, rules, recovery, approvals, the kill switch, bag export and backtests.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>jarvis_core</exec_depend>
  <exec_depend>jarvis_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2cli</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>rosbag2_storage_mcap</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
