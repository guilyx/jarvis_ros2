#!/bin/bash
# `inject <scenario>` with the ROS environment loaded, so `docker compose exec demo inject ...` works.
# shellcheck source=/dev/null # both exist only inside the image
source "/opt/ros/${ROS_DISTRO}/setup.bash" --
# shellcheck source=/dev/null
source /opt/jarvis/setup.bash --
exec ros2 run jarvis_demo inject "$@"
