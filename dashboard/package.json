{
  "name": "jarvis-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis dashboard: live events, faults, incidents, recovery, rules and analytics (served by jarvis_gateway)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "PYTHONPATH=../gateway/jarvis_gateway:../lake/jarvis_lake python3 -m jarvis_gateway.openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts && rm openapi.json"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-router": "1.132.0",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "5.6.0",
    "lucide-react": "0.545.0",
    "openapi-fetch": "0.14.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "4.1.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.8",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "6.1.1",
    "globals": "16.4.0",
    "jsdom": "27.0.0",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
