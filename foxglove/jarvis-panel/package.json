{
  "name": "jarvis-panel",
  "displayName": "Jarvis",
  "description": "Jarvis's open faults and event log in Foxglove and Lichtblick, live (foxglove_bridge) or from a recording",
  "publisher": "guilyx",
  "homepage": "https://github.com/guilyx/jarvis_ros2/tree/main/foxglove/jarvis-panel",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "./dist/extension.js",
  "keywords": [
    "ros2",
    "faults",
    "diagnostics",
    "recovery",
    "jarvis"
  ],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "2.59.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.3.2",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
