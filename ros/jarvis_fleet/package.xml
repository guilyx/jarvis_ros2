<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>jarvis_fleet</name>
  <version>0.1.0</version>
  <description>Rules and plans from the fleet's storage: every robot takes them from one place, lints them, loads what passes, and keeps what it had when they don't.</description>
  <maintainer email="erwin.lejeune15@gmail.com">Erwin L.</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://github.com/guilyx/jarvis_ros2</url>
  <url type="repository">https://github.com/guilyx/jarvis_ros2</url>
  <url type="bugtracker">https://github.com/guilyx/jarvis_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- pyarrow comes with jarvis_lake (its requirements.txt, pip). -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>jarvis_core</exec_depend>
  <exec_depend>jarvis_interfaces</exec_depend>
  <exec_depend>jarvis_lake</exec_depend>
  <exec_depend>jarvis_reporter</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
