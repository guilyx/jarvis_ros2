#!/usr/bin/env bash
# An SROS2 keystore for Jarvis (docs/guides/security.md): one enclave per Jarvis process, from
# security/policy.xml, plus the enclaves of any policy you add (your robot's nodes). Prints the
# environment to export. Running it again regenerates the enclaves' permissions, keeping the CA.
#
#   ros2 run jarvis_bringup jarvis_keystore KEYSTORE [POLICY.xml ...]
set -euo pipefail

if [ $# -lt 1 ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
fi
keystore=$(realpath -m "$1")
shift
policy="$(ros2 pkg prefix jarvis_bringup)/share/jarvis_bringup/security/policy.xml"

if [ ! -f "$keystore/public/ca.cert.pem" ]; then
  ros2 security create_keystore "$keystore"
fi
ros2 security generate_artifacts -k "$keystore" -p "$policy" "$@"

cat <<ENV
# Jarvis keystore ready: $keystore
export ROS_SECURITY_KEYSTORE=$keystore
export ROS_SECURITY_ENABLE=true
export ROS_SECURITY_STRATEGY=Enforce
# ros2 launch jarvis_bringup jarvis.launch.py runs as /jarvis/launch; its processes take their own:
#   ROS_SECURITY_ENCLAVE_OVERRIDE=/jarvis/launch ros2 launch jarvis_bringup jarvis.launch.py
# People (ros2 jarvis, monitor, ros2 topic ...): ROS_SECURITY_ENCLAVE_OVERRIDE=/jarvis/operator
ENV
